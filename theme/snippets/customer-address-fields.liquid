{%- comment -%}
  Address form fields shared by the "add" and "edit" address forms.
  Usage (inside {% form 'customer_address', … %}):
    {% render 'customer-address-fields', form: form, suffix: 'new', is_default: false %}
  Params:
    form        (required) the current form object
    suffix      (required) unique id suffix ('new' or the address id)
    is_default  true when the address is the customer's default address
  Country / province selects are wired up by assets/customer.js (Shopify.CountryProvinceSelector).
{%- endcomment -%}
{%- assign sfx = suffix | append: '' -%}
<div class="address-fields">
  <div class="field">
    <input class="field__input" type="text" id="AddressFirstName_{{ sfx }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" placeholder=" ">
    <label class="field__label" for="AddressFirstName_{{ sfx }}">{{ 'customer.addresses.first_name' | t }}</label>
  </div>
  <div class="field">
    <input class="field__input" type="text" id="AddressLastName_{{ sfx }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" placeholder=" ">
    <label class="field__label" for="AddressLastName_{{ sfx }}">{{ 'customer.addresses.last_name' | t }}</label>
  </div>
  <div class="field address-fields__full">
    <input class="field__input" type="text" id="AddressCompany_{{ sfx }}" name="address[company]" value="{{ form.company }}" autocomplete="organization" placeholder=" ">
    <label class="field__label" for="AddressCompany_{{ sfx }}">{{ 'customer.addresses.company' | t }}</label>
  </div>
  <div class="field address-fields__full">
    <input class="field__input" type="text" id="AddressAddress1_{{ sfx }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" placeholder=" ">
    <label class="field__label" for="AddressAddress1_{{ sfx }}">{{ 'customer.addresses.address1' | t }}</label>
  </div>
  <div class="field address-fields__full">
    <input class="field__input" type="text" id="AddressAddress2_{{ sfx }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" placeholder=" ">
    <label class="field__label" for="AddressAddress2_{{ sfx }}">{{ 'customer.addresses.address2' | t }}</label>
  </div>
  <div class="field">
    <input class="field__input" type="text" id="AddressCity_{{ sfx }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" placeholder=" ">
    <label class="field__label" for="AddressCity_{{ sfx }}">{{ 'customer.addresses.city' | t }}</label>
  </div>
  <div class="field">
    <input class="field__input" type="text" id="AddressZip_{{ sfx }}" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder=" ">
    <label class="field__label" for="AddressZip_{{ sfx }}">{{ 'customer.addresses.zip' | t }}</label>
  </div>
  <div class="field field--select">
    <select
      class="field__input field__select"
      id="AddressCountry_{{ sfx }}"
      name="address[country]"
      data-default="{{ form.country }}"
      autocomplete="country"
      data-address-country
      data-province-id="AddressProvince_{{ sfx }}"
      data-container-id="AddressProvinceContainer_{{ sfx }}"
    >
      {{ all_country_option_tags }}
    </select>
    <label class="field__label" for="AddressCountry_{{ sfx }}">{{ 'customer.addresses.country' | t }}</label>
    {%- render 'icon', name: 'chevron-down', size: 18, class: 'field__chevron' -%}
  </div>
  <div class="field field--select" id="AddressProvinceContainer_{{ sfx }}" style="display: none;">
    <select
      class="field__input field__select"
      id="AddressProvince_{{ sfx }}"
      name="address[province]"
      data-default="{{ form.province }}"
      autocomplete="address-level1"
    ></select>
    <label class="field__label" for="AddressProvince_{{ sfx }}">{{ 'customer.addresses.province' | t }}</label>
    {%- render 'icon', name: 'chevron-down', size: 18, class: 'field__chevron' -%}
  </div>
  <div class="field address-fields__full">
    <input class="field__input" type="tel" id="AddressPhone_{{ sfx }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder=" ">
    <label class="field__label" for="AddressPhone_{{ sfx }}">{{ 'customer.addresses.phone' | t }}</label>
  </div>
  <label class="check address-fields__full" for="AddressDefault_{{ sfx }}">
    <input
      type="checkbox"
      id="AddressDefault_{{ sfx }}"
      name="address[default]"
      value="1"
      {% if is_default %}
        checked
      {% endif %}
    >
    <span>{{ 'customer.addresses.set_default' | t }}</span>
  </label>
</div>
