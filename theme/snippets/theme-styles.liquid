{%- comment -%}
  Fonts + global CSS custom properties + color scheme classes.
  Rendered once in <head> by layout/theme.liquid, layout/password.liquid and templates/gift_card.liquid.
  Fonts come from Shopify's font library (font_picker settings → font_face / font_url), served by Shopify's CDN.
{%- endcomment -%}
{%- liquid
  assign display_font = settings.type_display_font
  assign body_font = settings.type_body_font
  assign mono_font = settings.type_mono_font

  # Font stacks: library families are quoted, system families (e.g. -apple-system) must not be.
  assign display_stack = display_font.family | prepend: '"' | append: '"'
  if display_font.system?
    assign display_stack = display_font.family
  endif
  assign display_stack = display_stack | append: ', ' | append: display_font.fallback_families
  assign body_stack = body_font.family | prepend: '"' | append: '"'
  if body_font.system?
    assign body_stack = body_font.family
  endif
  assign body_stack = body_stack | append: ', ' | append: body_font.fallback_families
  assign mono_stack = ''
  if settings.font_mono_enabled
    assign mono_stack = mono_font.family | prepend: '"' | append: '", '
    if mono_font.system?
      assign mono_stack = mono_font.family | append: ', '
    endif
  endif

  # Heading size compensation for unusually wide / narrow display faces (1 = as designed).
  assign display_family = display_font.family | downcase
  case display_family
    when 'unbounded'
      assign display_adjust = 0.84
    when 'archivo black', 'syne'
      assign display_adjust = 0.94
    when 'oswald', 'barlow condensed', 'archivo narrow'
      assign display_adjust = 1.12
    when 'bebas neue', 'anton'
      assign display_adjust = 1.24
    else
      assign display_adjust = 1
  endcase

  assign display_weight = display_font.weight | append: ''
  assign body_weight = body_font.weight | append: ''
  assign display_url = display_font | font_url
  assign body_url = body_font | font_url

  case settings.corner_style
    when 'sharp'
      assign r_xs = 0
      assign r_sm = 2
      assign r_md = 3
      assign r_lg = 4
      assign r_xl = 6
      assign r_card = 3
      assign r_btn = '2px'
    when 'round'
      assign r_xs = 6
      assign r_sm = 10
      assign r_md = 16
      assign r_lg = 24
      assign r_xl = 32
      assign r_card = 16
      assign r_btn = '999px'
    else
      assign r_xs = 4
      assign r_sm = 8
      assign r_md = 12
      assign r_lg = 18
      assign r_xl = 26
      assign r_card = 12
      assign r_btn = '10px'
  endcase
-%}
<link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
{% # theme-check-disable AssetPreload %}
{%- # Font preloads need type + crossorigin, which preload_tag cannot set (same pattern as Dawn). -%}
{%- unless display_font.system? or display_url == blank %}
  <link rel="preload" as="font" href="{{ display_url }}" type="font/woff2" crossorigin>
{%- endunless -%}
{%- unless body_font.system? or body_url == blank or body_url == display_url %}
  <link rel="preload" as="font" href="{{ body_url }}" type="font/woff2" crossorigin>
{%- endunless %}
{% # theme-check-enable AssetPreload %}

{% style %}
  {{ display_font | font_face: font_display: 'swap' }}
  {%- for weight in (6..9) -%}
    {%- assign w = weight | times: 100 | append: '' -%}
    {%- unless w == display_weight -%}
      {%- assign face = display_font | font_modify: 'weight', w -%}
      {{ face | font_face: font_display: 'swap' }}
    {%- endunless -%}
  {%- endfor %}
  {{ body_font | font_face: font_display: 'swap' }}
  {%- for weight in (5..9) -%}
    {%- assign w = weight | times: 100 | append: '' -%}
    {%- unless w == body_weight -%}
      {%- assign face = body_font | font_modify: 'weight', w -%}
      {{ face | font_face: font_display: 'swap' }}
    {%- endunless -%}
  {%- endfor -%}
  {%- assign body_italic = body_font | font_modify: 'style', 'italic' -%}
  {%- assign body_bold = body_font | font_modify: 'weight', 'bold' -%}
  {%- assign body_bold_italic = body_bold | font_modify: 'style', 'italic' %}
  {{ body_italic | font_face: font_display: 'swap' }}
  {{ body_bold_italic | font_face: font_display: 'swap' }}
  {%- if mono_stack != '' -%}
    {%- assign mono_medium = mono_font | font_modify: 'weight', '500' -%}
    {%- assign mono_bold = mono_font | font_modify: 'weight', 'bold' %}
    {{ mono_font | font_face: font_display: 'swap' }}
    {{ mono_medium | font_face: font_display: 'swap' }}
    {{ mono_bold | font_face: font_display: 'swap' }}
  {%- endif %}

  :root {
    --font-display: {{ display_stack }};
    --font-display-weight: {{ display_font.weight }};
    --font-display-stretch: normal;
    --font-display-case: {{ settings.heading_case }};
    --heading-adjust: {{ display_adjust }};
    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --font-body: {{ body_stack }};
    --font-body-weight: {{ body_font.weight }};
    --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
    --font-mono: {{ mono_stack }}ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    --page-width: {{ settings.page_width }}px;
    --section-spacing-scale: {{ settings.section_spacing | divided_by: 100.0 }};
    --grid-gap-desktop: {{ settings.grid_gap }}px;

    --radius-xs: {{ r_xs }}px;
    --radius-sm: {{ r_sm }}px;
    --radius-md: {{ r_md }}px;
    --radius-lg: {{ r_lg }}px;
    --radius-xl: {{ r_xl }}px;
    --radius-card: {{ r_card }}px;
    --radius-btn: {{ r_btn }};

    --logo-width: {{ settings.logo_width }}px;
    --logo-width-mobile: {{ settings.logo_width_mobile }}px;
  }

  {% for scheme in settings.color_schemes -%}
    {%- liquid
      assign bg = scheme.settings.background
      assign surface = scheme.settings.surface
      assign text = scheme.settings.text
      assign muted = scheme.settings.text_muted
      assign accent = scheme.settings.accent
      assign on_accent = scheme.settings.on_accent
      assign border = scheme.settings.border
    -%}
    {% if forloop.first %}:root,{% endif %}
    .color-{{ scheme.id }} {
      --color-bg: {{ bg }};
      --color-bg-rgb: {{ bg.red }} {{ bg.green }} {{ bg.blue }};
      --color-bg-gradient: {% if scheme.settings.background_gradient != blank %}{{ scheme.settings.background_gradient }}{% else %}{{ bg }}{% endif %};
      --color-surface: {{ surface }};
      --color-surface-rgb: {{ surface.red }} {{ surface.green }} {{ surface.blue }};
      --color-text: {{ text }};
      --color-text-rgb: {{ text.red }} {{ text.green }} {{ text.blue }};
      --color-muted: {{ muted }};
      --color-muted-rgb: {{ muted.red }} {{ muted.green }} {{ muted.blue }};
      --color-accent: {{ accent }};
      --color-accent-rgb: {{ accent.red }} {{ accent.green }} {{ accent.blue }};
      --color-on-accent: {{ on_accent }};
      --color-border: {{ border }};
      --color-border-rgb: {{ border.red }} {{ border.green }} {{ border.blue }};
    }
  {%- endfor %}
{% endstyle %}

{%- if settings.page_transitions and settings.animations_enabled -%}
  <style>
    @media (prefers-reduced-motion: no-preference) {
      @view-transition { navigation: auto; }
    }
  </style>
{%- endif -%}
