{%- comment -%}
  UI icon set (24x24, stroke = currentColor).
  Usage: {% render 'icon', name: 'cart', size: 20, class: 'my-class' %}
  Params: name (required), size (px, default 20), class (optional), stroke (default 1.75)
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 20
  assign icon_stroke = stroke | default: 1.75
-%}
<svg
  class="icon icon--{{ name }}{% if class %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="{{ icon_stroke }}"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-left' -%}
      <path d="M19 12H5M11 6l-6 6 6 6"/>
    {%- when 'arrow-up-right' -%}
      <path d="M7 17 17 7M8 7h9v9"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
