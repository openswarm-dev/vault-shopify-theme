      <rect x="4" y="9" width="16" height="11.5" rx="1.5"/><path d="M3.5 9h17M12 9v11.5M12 9S10.8 4 8.2 4.4C6 4.8 6.8 9 12 9Zm0 0s1.2-5 3.8-4.6C18 4.8 17.2 9 12 9Z"/>
