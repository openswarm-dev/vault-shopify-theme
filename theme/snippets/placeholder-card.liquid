{%- comment -%}
  Stylized trading-card artwork shown when a merchant hasn't picked an image yet,
  so every section looks finished out of the box.
  Usage: {% render 'placeholder-card', variant: 2, uid: section.id, label: 'Card artwork', class: 'my-class' %}
  Params:
    variant  1–6 (palette + emblem), default 1
    uid      unique string for SVG ids (recommended when several render on one page)
    label    accessible label (optional; decorative when omitted)
    class    extra classes (optional)
    graded   true → draws the card inside a grading slab with a red label
{%- endcomment -%}
{%- liquid
  assign v = variant | default: 1 | minus: 1 | modulo: 6 | plus: 1
  assign id = uid | default: 'pc' | append: '-' | append: v | handleize
  case v
    when 2
      assign c1 = '#2a2d35'
      assign c2 = '#0b0c0f'
      assign glow = '#ff4b5c'
      assign title = 'VOID REAPER'
      assign num = '113/110'
      assign hp = '210'
    when 3
      assign c1 = '#7a0812'
      assign c2 = '#160204'
      assign glow = '#ffb547'
      assign title = 'INFERNO KIRIN'
      assign num = '025/198'
      assign hp = '180'
    when 4
      assign c1 = '#3a3d46'
      assign c2 = '#121318'
      assign glow = '#60a5fa'
      assign title = 'TIDE SOVEREIGN'
      assign num = '067/165'
      assign hp = '160'
    when 5
      assign c1 = '#b10f1f'
      assign c2 = '#25050a'
      assign glow = '#fde68a'
      assign title = 'CRIMSON TITAN'
      assign num = 'SV-001'
      assign hp = '330'
    when 6
      assign c1 = '#1f2128'
      assign c2 = '#050506'
      assign glow = '#a78bfa'
      assign title = 'ASTRAL ORACLE'
      assign num = '201/195'
      assign hp = '150'
    else
      assign c1 = '#e11d2e'
      assign c2 = '#2b0509'
      assign glow = '#ff8a3d'
      assign title = 'EMBER DRAKE'
      assign num = '004/102'
      assign hp = '120'
  endcase
-%}
<svg
  class="placeholder-card{% if class %} {{ class }}{% endif %}"
  viewBox="0 0 {% if graded %}760 1180{% else %}630 880{% endif %}"
  xmlns="http://www.w3.org/2000/svg"
  preserveAspectRatio="xMidYMid meet"
  {% if label %}role="img" aria-label="{{ label | escape }}"{% else %}aria-hidden="true" focusable="false"{% endif %}
>
  <defs>
    <linearGradient id="{{ id }}-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="{{ c1 }}"/>
      <stop offset="1" stop-color="{{ c2 }}"/>
    </linearGradient>
    <radialGradient id="{{ id }}-orb" cx="50%" cy="45%" r="55%">
      <stop offset="0" stop-color="{{ glow }}" stop-opacity=".95"/>
      <stop offset=".35" stop-color="{{ c1 }}" stop-opacity=".7"/>
      <stop offset="1" stop-color="{{ c2 }}" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="{{ id }}-foil" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ff3344" stop-opacity=".0"/>
      <stop offset=".3" stop-color="#fff35c" stop-opacity=".18"/>
      <stop offset=".5" stop-color="#5eead4" stop-opacity=".22"/>
      <stop offset=".7" stop-color="#a78bfa" stop-opacity=".18"/>
      <stop offset="1" stop-color="#ff3344" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="{{ id }}-frame" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a3c44"/>
      <stop offset=".5" stop-color="#1b1c21"/>
      <stop offset="1" stop-color="#2c2e35"/>
    </linearGradient>
    <pattern id="{{ id }}-grid" width="22" height="22" patternUnits="userSpaceOnUse">
      <path d="M22 0H0V22" fill="none" stroke="#fff" stroke-opacity=".06" stroke-width="1"/>
    </pattern>
  </defs>

  {%- if graded -%}
    <rect x="4" y="4" width="752" height="1172" rx="34" fill="#d9dbe1" fill-opacity=".1" stroke="#e7e8ec" stroke-opacity=".35" stroke-width="3"/>
    <rect x="34" y="34" width="692" height="190" rx="14" fill="#f4f4f5"/>
    <rect x="34" y="34" width="692" height="46" rx="14" fill="#d50f25"/>
    <rect x="34" y="62" width="692" height="18" fill="#d50f25"/>
    <text x="60" y="66" font-family="Arial, Helvetica, sans-serif" font-size="24" font-weight="700" fill="#fff" letter-spacing="3">CERTIFIED</text>
    <text x="700" y="66" text-anchor="end" font-family="Arial, Helvetica, sans-serif" font-size="22" font-weight="700" fill="#fff" letter-spacing="2">#{{ num | remove: '/' | remove: '-' }}2048</text>
    <text x="60" y="128" font-family="Arial, Helvetica, sans-serif" font-size="30" font-weight="800" fill="#111214">{{ title }}</text>
    <text x="60" y="170" font-family="Arial, Helvetica, sans-serif" font-size="22" fill="#55565e">HOLO · {{ num }}</text>
    <text x="700" y="140" text-anchor="end" font-family="Arial, Helvetica, sans-serif" font-size="26" font-weight="800" fill="#111214">GEM MT</text>
    <text x="700" y="198" text-anchor="end" font-family="Arial, Helvetica, sans-serif" font-size="58" font-weight="900" fill="#d50f25">10</text>
    <g transform="translate(65 262)">
  {%- else -%}
    <g>
  {%- endif -%}
    <rect width="630" height="880" rx="34" fill="url(#{{ id }}-frame)"/>
    <rect x="20" y="20" width="590" height="840" rx="22" fill="url(#{{ id }}-bg)"/>
    <rect x="20" y="20" width="590" height="840" rx="22" fill="url(#{{ id }}-grid)"/>

    <text x="52" y="82" font-family="Arial, Helvetica, sans-serif" font-size="34" font-weight="900" fill="#fff" letter-spacing="1">{{ title }}</text>
    <text x="578" y="82" text-anchor="end" font-family="Arial, Helvetica, sans-serif" font-size="30" font-weight="900" fill="#fff"><tspan font-size="18" dy="-2">HP </tspan>{{ hp }}</text>

    <rect x="48" y="108" width="534" height="392" rx="14" fill="#07080a" stroke="#fff" stroke-opacity=".25" stroke-width="3"/>
    <circle cx="315" cy="304" r="230" fill="url(#{{ id }}-orb)"/>
    <g fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round">
      {%- case v -%}
        {%- when 2 -%}
          <path d="M315 170 L395 304 L315 438 L235 304 Z" stroke-width="5"/>
          <path d="M315 210 L365 304 L315 398 L265 304 Z" stroke-width="3" stroke-opacity=".6"/>
          <circle cx="315" cy="304" r="22" fill="#fff" stroke="none"/>
        {%- when 3 -%}
          <path d="M315 160 C 360 230, 420 260, 380 330 C 360 370, 330 380, 315 440 C 300 380, 270 370, 250 330 C 210 260, 270 230, 315 160 Z" stroke-width="5"/>
          <path d="M315 250 C 335 290, 350 310, 315 370 C 280 310, 295 290, 315 250 Z" fill="#fff" fill-opacity=".85" stroke="none"/>
        {%- when 4 -%}
          <circle cx="315" cy="304" r="110" stroke-width="5"/>
          <path d="M205 304 C 245 264, 285 344, 315 304 S 385 264, 425 304" stroke-width="5"/>
          <path d="M215 344 C 255 304, 285 384, 315 344 S 385 304, 415 344" stroke-width="3" stroke-opacity=".6"/>
        {%- when 5 -%}
          <path d="M315 160 L345 270 L455 270 L365 335 L400 445 L315 380 L230 445 L265 335 L175 270 L285 270 Z" stroke-width="5"/>
          <circle cx="315" cy="310" r="34" fill="#fff" stroke="none"/>
        {%- when 6 -%}
          <circle cx="315" cy="304" r="120" stroke-width="3" stroke-dasharray="6 12"/>
          <circle cx="315" cy="304" r="80" stroke-width="5"/>
          <circle cx="315" cy="304" r="30" fill="#fff" stroke="none"/>
          <path d="M315 160 V200 M315 408 V448 M171 304 H211 M419 304 H459" stroke-width="5"/>
        {%- else -%}
          <path d="M240 400 C 230 300, 300 250, 315 170 C 330 250, 400 300, 390 400 C 380 440, 250 440, 240 400 Z" stroke-width="5"/>
          <path d="M282 395 C 280 345, 310 320, 315 280 C 322 320, 352 345, 348 395 Z" fill="#fff" fill-opacity=".9" stroke="none"/>
      {%- endcase -%}
    </g>

    <rect x="48" y="516" width="534" height="40" rx="8" fill="#000" fill-opacity=".35"/>
    <text x="68" y="543" font-family="Arial, Helvetica, sans-serif" font-size="19" font-weight="700" fill="#fff" fill-opacity=".85" letter-spacing="2">LEGENDARY · STAGE 2</text>

    <rect x="48" y="580" width="534" height="200" rx="12" fill="#000" fill-opacity=".28"/>
    <rect x="72" y="610" width="300" height="16" rx="8" fill="#fff" fill-opacity=".85"/>
    <rect x="72" y="644" width="486" height="10" rx="5" fill="#fff" fill-opacity=".35"/>
    <rect x="72" y="666" width="440" height="10" rx="5" fill="#fff" fill-opacity=".35"/>
    <rect x="72" y="704" width="250" height="16" rx="8" fill="#fff" fill-opacity=".85"/>
    <rect x="72" y="738" width="400" height="10" rx="5" fill="#fff" fill-opacity=".35"/>

    <text x="52" y="830" font-family="Consolas, Menlo, monospace" font-size="20" fill="#fff" fill-opacity=".7">{{ num }}</text>
    <path d="M565 812 l7 14 15 2 -11 10 3 15 -14 -7 -14 7 3 -15 -11 -10 15 -2 Z" fill="{{ glow }}"/>

    <rect x="20" y="20" width="590" height="840" rx="22" fill="url(#{{ id }}-foil)"/>
  </g>
</svg>
