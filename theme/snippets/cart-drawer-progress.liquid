{%- comment -%}
  Free-shipping progress (cart drawer). Shown when settings.free_shipping_threshold is a positive
  number (major units of the store currency) and the cart has items. The fill is animated by
  component-cart-drawer.js (from the previous value; sparkle burst when unlocked).
  - The threshold is in the store currency, so the bar only shows when the cart is presented in
    that currency (Markets visitors paying in another currency would see a wrong amount).
  - "75", "75.00", "1,000" and the decimal-comma "75,00" all parse.
  - Progress is integer math (basis points) so it is exact whatever the Liquid number types are.
{%- endcomment -%}
{%- liquid
  assign threshold_raw = settings.free_shipping_threshold | strip | remove: ' '
  assign threshold_parts = threshold_raw | split: ','
  if threshold_parts.size == 2 and threshold_parts.last.size <= 2
    assign threshold_raw = threshold_raw | remove: '.' | replace: ',', '.'
  else
    assign threshold_raw = threshold_raw | remove: ','
  endif
  assign threshold_cents = threshold_raw | times: 100 | round
  assign same_currency = true
  if cart.currency.iso_code != blank and shop.currency != blank and cart.currency.iso_code != shop.currency
    assign same_currency = false
  endif
-%}
{%- if threshold_cents > 0 and cart.item_count > 0 and same_currency -%}
  {%- liquid
    assign remaining = threshold_cents | minus: cart.total_price
    assign remaining_money = remaining | at_least: 0 | money
    assign progress_bp = cart.total_price | times: 10000 | divided_by: threshold_cents | at_most: 10000 | at_least: 0
    assign progress = progress_bp | divided_by: 10000.0
    assign progress_pct = progress_bp | plus: 50 | divided_by: 100
    assign unlocked = false
    if remaining <= 0
      assign unlocked = true
    endif
  -%}
  <div
    class="cart-progress{% if unlocked %} is-unlocked{% endif %}"
    data-cart-progress
    data-progress="{{ progress }}"
    data-unlocked="{{ unlocked }}"
  >
    <p class="cart-progress__text">
      {%- if unlocked -%}
        {%- render 'icon', name: 'sparkle', size: 16, class: 'cart-progress__icon' -%}
        <span>{{ 'cart.general.free_shipping_unlocked' | t }}</span>
      {%- else -%}
        {%- render 'icon', name: 'truck', size: 16, class: 'cart-progress__icon' -%}
        <span>{{ 'cart.general.free_shipping_remaining' | t: amount: remaining_money }}</span>
      {%- endif -%}
    </p>
    <div class="cart-progress__bar">
      <div
        class="cart-progress__track"
        role="progressbar"
        aria-label="{{ 'sections.cart_drawer.free_shipping_label' | t }}"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ progress_pct }}"
      >
        <span class="cart-progress__fill" style="--progress: {{ progress }};" data-cart-progress-fill></span>
      </div>
      <span class="cart-progress__burst" data-cart-progress-burst aria-hidden="true"></span>
    </div>
  </div>
{%- endif -%}
