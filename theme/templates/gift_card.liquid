{% layout none %}
{%- liquid
  assign balance = gift_card.balance | money
  assign initial = gift_card.initial_value | money
  assign initial_plain = gift_card.initial_value | money_without_trailing_zeros | strip_html
  assign balance_plain = gift_card.balance | money_without_trailing_zeros | strip_html

  assign expiry = ''
  if gift_card.expires_on
    assign expiry = gift_card.expires_on | date: '%B %-d, %Y'
  endif

  assign inactive = false
  if gift_card.expired or gift_card.enabled == false
    assign inactive = true
  endif

  assign last_four = gift_card.last_four_characters | upcase
-%}
<!doctype html>
<html
  class="no-js{% if settings.animations_enabled %} motion-pref{% endif %}"
  lang="{{ request.locale.iso_code }}"
  data-anim="{{ settings.animation_intensity }}"
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    {%- for scheme in settings.color_schemes limit: 1 %}
      <meta name="theme-color" content="{{ scheme.settings.background }}">
    {%- endfor %}
    <meta name="color-scheme" content="dark">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ 'gift_cards.issued.title' | t: value: initial_plain, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t | escape }}">

    <script>
      (function () {
        var html = document.documentElement;
        html.className = html.className.replace('no-js', 'js');
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (html.classList.contains('motion-pref') && !reduce) html.classList.add('motion-ok');
        if (window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches) html.classList.add('can-hover');
        window.setTimeout(function () {
          if (!window.Vault || !window.Vault.ready) html.classList.remove('motion-ok');
        }, 3500);
      })();
    </script>

    {%- if settings.animations_enabled %}<script src="{{ 'motion.js' | asset_url }}" defer></script>{% endif %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script src="{{ 'component-gift-card.js' | asset_url }}" defer></script>

    {{ content_for_header }}

    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'component-gift-card.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-gift-card">
    {%- if settings.grain_overlay -%}
      <div class="fx-grain" aria-hidden="true"></div>
    {%- endif -%}
    <div class="gift-bg" aria-hidden="true"></div>

    <main id="MainContent" class="gift" tabindex="-1">
      <header class="gift__bar">
        <a href="{{ shop.url }}" class="gift__brand">
          {%- if settings.logo != blank -%}
            {%- assign logo_alt = settings.logo.alt | default: shop.name -%}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'gift__logo',
                widths: '150, 300, 450, 600',
                sizes: '160px',
                alt: logo_alt,
                loading: 'eager'
            }}
          {%- else -%}
            <span class="gift__wordmark">{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>
        <span class="gift__tag">{{ 'gift_cards.issued.card_label' | t }}</span>
      </header>

      <div class="gift__layout">
        <div class="gift__card-col">
          <div class="gift__card-glow" aria-hidden="true"></div>
          <holo-card class="gift-card{% if inactive %} is-inactive{% endif %}" data-foil="intense" data-max-tilt="14" data-reveal="card">
            <div class="holo gift-card__holo">
              <div class="gift-card__face">
                <div class="gift-card__top">
                  <span class="gift-card__shop">{{ shop.name | escape }}</span>
                  <span class="gift-card__kind">{{ 'gift_cards.issued.card_label' | t }}</span>
                </div>
                <div class="gift-card__window">
                  <span class="gift-card__emblem" aria-hidden="true">
                    {%- render 'icon', name: 'gift', size: 28, stroke: 1.5 -%}
                  </span>
                  <span class="gift-card__value">{{ balance_plain }}</span>
                  <span class="gift-card__value-label">{{ 'gift_cards.issued.balance' | t }}</span>
                </div>
                <div class="gift-card__type">{{ 'gift_cards.issued.card_type' | t }}</div>
                <div class="gift-card__text">
                  <p>{{ 'gift_cards.issued.card_text' | t }}</p>
                </div>
                <div class="gift-card__foot">
                  <span class="mono">&bull;&bull;&bull;&bull; {{ last_four }}</span>
                  <span class="gift-card__star" aria-hidden="true"></span>
                </div>
              </div>
              <span class="holo__shine" aria-hidden="true"></span>
              <span class="holo__glare" aria-hidden="true"></span>
            </div>
          </holo-card>

          {%- if inactive -%}
            <p class="gift__status">
              {%- render 'icon', name: 'alert', size: 16 -%}
              <span>
                {%- if gift_card.expired -%}
                  {{ 'gift_cards.issued.expired' | t: expiry: expiry }}
                {%- else -%}
                  {{ 'gift_cards.issued.disabled' | t }}
                {%- endif -%}
              </span>
            </p>
          {%- endif -%}
        </div>

        <div class="gift__details">
          <p class="eyebrow" data-reveal="fade">{{ 'gift_cards.issued.eyebrow' | t: shop: shop.name }}</p>
          <h1 class="h1 gift__title" data-split>{{ 'gift_cards.issued.heading_html' | t: value: initial_plain }}</h1>
          <p class="lead gift__lead" data-reveal>{{ 'gift_cards.issued.subtext' | t }}</p>

          {%- if gift_card.message != blank -%}
            <figure class="gift__message" data-reveal>
              <figcaption>{{ 'gift_cards.issued.message_label' | t }}</figcaption>
              <blockquote>{{ gift_card.message | escape | newline_to_br }}</blockquote>
            </figure>
          {%- endif -%}

          <dl class="gift__stats" data-reveal>
            <div class="gift__stat">
              <dt>{{ 'gift_cards.issued.balance' | t }}</dt>
              <dd class="gift__stat-value gift__stat-value--accent">{{ balance }}</dd>
            </div>
            {%- if gift_card.balance != gift_card.initial_value -%}
              <div class="gift__stat">
                <dt>{{ 'gift_cards.issued.original_value' | t }}</dt>
                <dd class="gift__stat-value">{{ initial }}</dd>
              </div>
            {%- endif -%}
            <div class="gift__stat">
              <dt>{{ 'gift_cards.issued.expires' | t }}</dt>
              <dd class="gift__stat-value">
                {%- if expiry != blank -%}
                  {{ expiry }}
                {%- else -%}
                  {{ 'gift_cards.issued.no_expiry' | t }}
                {%- endif -%}
              </dd>
            </div>
          </dl>

          <div class="gift__code" data-reveal>
            <p class="gift__label" id="GiftCardCodeLabel">{{ 'gift_cards.issued.code_label' | t }}</p>
            <div class="gift__code-row">
              <code class="gift__code-value" aria-labelledby="GiftCardCodeLabel">{{ gift_card.code }}</code>
              <button
                type="button"
                class="btn btn--secondary gift__copy"
                data-gift-copy
                data-code="{{ gift_card.code | escape }}"
                data-copied="{{ 'gift_cards.issued.copied' | t | escape }}"
                data-copy-error="{{ 'gift_cards.issued.copy_error' | t | escape }}"
              >
                <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="8.5" y="8.5" width="11.5" height="11.5" rx="2"/><path d="M15.5 8.5V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7.5a2 2 0 0 0 2 2h2.5"/></svg>
                <span data-gift-copy-label>{{ 'gift_cards.issued.copy_code' | t }}</span>
              </button>
            </div>
            <p class="visually-hidden" role="status" aria-live="polite" data-gift-status></p>
          </div>

          <div class="gift__redeem" data-reveal>
            <div class="gift__qr" data-gift-qr="{{ gift_card.qr_identifier | escape }}" role="img" aria-label="{{ 'gift_cards.issued.qr_image_alt' | t | escape }}"></div>
            <div class="gift__redeem-text">
              <p class="gift__label">{{ 'gift_cards.issued.qr_label' | t }}</p>
              <p class="gift__redeem-copy">{{ 'gift_cards.issued.qr_text' | t }}</p>
              {%- if gift_card.pass_url -%}
                <a href="{{ gift_card.pass_url }}" class="gift__wallet">
                  <img
                    src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                    width="120"
                    height="40"
                    alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t | escape }}"
                    loading="lazy"
                  >
                </a>
              {%- endif -%}
            </div>
          </div>

          <div class="gift__actions" data-reveal>
            <a href="{{ shop.url }}" class="btn btn--primary btn--lg">
              <span>{{ 'gift_cards.issued.shop_link' | t }}</span>
              {%- render 'icon', name: 'arrow-right', size: 18 -%}
            </a>
            <button type="button" class="btn btn--secondary btn--lg" data-gift-print>
              <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 9V3.5h10V9"/><rect x="3.5" y="9" width="17" height="8" rx="2"/><path d="M7 14h10v6.5H7z"/></svg>
              <span>{{ 'gift_cards.issued.print' | t }}</span>
            </button>
          </div>
        </div>
      </div>

      <footer class="gift__foot">
        <p>&copy; {{ 'now' | date: '%Y' }} <a href="{{ shop.url }}">{{ shop.name | escape }}</a></p>
      </footer>
    </main>

    <div class="toast-region" data-toast-region role="status" aria-live="polite"></div>

    <script>
      window.routes = { root: {{ routes.root_url | json }} };
      window.theme = {
        moneyFormat: {{ shop.money_format | json }},
        locale: {{ request.locale.iso_code | json }},
        settings: {
          holo: {{ settings.card_holo | json }},
          tilt: {{ settings.card_tilt | json }}
        },
        strings: {}
      };
    </script>
  </body>
</html>
