    "content_a_grades": {
      "type": "grade-scale",
      "settings": {
        "eyebrow": "Grading 101",
        "heading": "Know your <em>grade</em>",
        "text": "<p>Every slab tells a story. Step through the scale to see exactly what separates a Gem Mint 10 from a well-loved 1.</p>",
        "link_label": "Shop graded slabs",
        "link_url": "/collections/all",
        "grader": "PSA",
        "card_variant": 1,
        "show_wear": true,
        "note": "Descriptions follow PSA's published standards. BGS, CGC, SGC and TAG use similar 1–10 scales with half-point grades in between.",
        "color_scheme": "scheme-1",
        "padding_top": 100,
        "padding_bottom": 100
      },
      "blocks": {
        "grade_10": {
          "type": "tier",
          "settings": {
            "score": "10",
            "label": "Gem Mint",
            "abbr": "GEM MT",
            "description": "A virtually perfect card: four sharp corners, sharp focus, full original gloss and no staining. Centering around 55/45 or better on the front.",
            "color": "#e11d2e"
          }
        },
        "grade_9": {
          "type": "tier",
          "settings": {
            "score": "9",
            "label": "Mint",
            "abbr": "MINT",
            "description": "A superb card with just one minor flaw — a tiny wax stain on the back, a small print spot or slightly off-white borders. Centering about 60/40 or better.",
            "color": "#f2545b"
          }
        },
        "grade_8": {
          "type": "tier",
          "settings": {
            "score": "8",
            "label": "Near Mint–Mint",
            "abbr": "NM-MT",
            "description": "Looks Mint at a glance. Allows a very slight fray on one or two corners, a minor print imperfection or slightly off-white borders. Centering about 65/35.",
            "color": "#f97316"
          }
        },
        "grade_7": {
          "type": "tier",
          "settings": {
            "score": "7",
            "label": "Near Mint",
            "abbr": "NM",
            "description": "Slight surface wear visible on close inspection and light fraying on some corners. Most of the original gloss remains. Centering about 70/30.",
            "color": "#f59e0b"
          }
        },
        "grade_6": {
          "type": "tier",
          "settings": {
            "score": "6",
            "label": "Excellent–Mint",
            "abbr": "EX-MT",
            "description": "Visible surface wear or a print defect, light scratches, slight edge notching and some loss of gloss. Corners may show fraying. Centering about 80/20.",
            "color": "#d4d4d8"
          }
        },
        "grade_5": {
          "type": "tier",
          "settings": {
            "score": "5",
            "label": "Excellent",
            "abbr": "EX",
            "description": "Very minor corner rounding becomes evident, with surface wear, light scratches and some chipping along the edges. Centering about 85/15.",
            "color": "#b8b8c0"
          }
        },
        "grade_4": {
          "type": "tier",
          "settings": {
            "score": "4",
            "label": "Very Good–Excellent",
            "abbr": "VG-EX",
            "description": "Slightly rounded corners, noticeable surface wear and scuffing, and some loss of gloss. A light crease may be visible. Centering about 85/15.",
            "color": "#9d9da6"
          }
        },
        "grade_3": {
          "type": "tier",
          "settings": {
            "score": "3",
            "label": "Very Good",
            "abbr": "VG",
            "description": "Rounded corners, obvious surface wear and possible light creasing. Most of the original gloss is gone and borders may be yellowed. Centering about 90/10.",
            "color": "#83838d"
          }
        },
        "grade_2": {
          "type": "tier",
          "settings": {
            "score": "2",
            "label": "Good",
            "abbr": "GOOD",
            "description": "Heavy corner wear, scratching, surface staining and several creases, with significant gloss loss — but the card is still fully intact.",
            "color": "#6a6a74"
          }
        },
        "grade_1": {
          "type": "tier",
          "settings": {
            "score": "1",
            "label": "Poor",
            "abbr": "PR",
            "description": "Extreme wear: heavy creases, scuffing, missing pieces or major defects that affect the card's structure. Still identifiable — and often still treasured.",
            "color": "#55555e"
          }
        }
      },
      "block_order": [
        "grade_10",
        "grade_9",
        "grade_8",
        "grade_7",
        "grade_6",
        "grade_5",
        "grade_4",
        "grade_3",
        "grade_2",
        "grade_1"
      ]
    },
