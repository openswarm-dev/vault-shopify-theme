    "collector_faq": {
      "type": "faq",
      "settings": {
        "eyebrow": "Help centre",
        "heading": "Collector questions, <em>answered</em>",
        "text": "Authenticity, grading, shipping and everything in between. If it is not here, ask a real collector on our team.",
        "single_open": true,
        "open_first": true,
        "show_numbers": true,
        "enable_schema": true,
        "show_contact": true,
        "contact_heading": "Still got questions?",
        "contact_text": "Our team are collectors too. Ask about a card, a grade or a trade and get a real answer from a human.",
        "contact_button_label": "Contact us",
        "contact_note": "Average reply time: under 2 hours",
        "color_scheme": "scheme-1",
        "padding_top": 100,
        "padding_bottom": 100
      },
      "blocks": {
        "faq_authentic": {
          "type": "question",
          "settings": {
            "question": "Are your cards guaranteed authentic?",
            "answer": "<p>Yes. Every single and slab is inspected by hand under magnification and UV light before it is listed, and graded slabs are checked against the grader's cert database. If anything we sell is ever proven inauthentic, you get a full refund with no time limit.</p>"
          }
        },
        "faq_condition": {
          "type": "question",
          "settings": {
            "question": "How do you describe raw card condition?",
            "answer": "<p>We use the standard scale: Near Mint, Lightly Played, Moderately Played, Heavily Played and Damaged. Centering, corners, edges and surface are checked individually, and higher-value singles are photographed front and back so the card you see is the card you get.</p>"
          }
        },
        "faq_shipping": {
          "type": "question",
          "settings": {
            "question": "How are orders packed and protected?",
            "answer": "<p>Singles ship in a penny sleeve and top-loader, sealed in a team bag inside a rigid bubble mailer. Slabs and sealed product ship boxed with edge protection. Every order is tracked, and higher-value orders are fully insured until they reach your door.</p>"
          }
        },
        "faq_returns": {
          "type": "question",
          "settings": {
            "question": "Can I return a graded card?",
            "answer": "<p>Yes, within 14 days of delivery as long as the slab is unaltered. We record the cert number of every slab we ship and match it on return. Sealed product must be unopened with the factory wrap intact.</p>"
          }
        },
        "faq_buying": {
          "type": "question",
          "settings": {
            "question": "Do you buy collections?",
            "answer": "<p>We do. Send us a list or photos of your singles, binders, slabs or sealed product and we will come back with a cash or store credit offer within 48 hours. Store credit offers are 20% higher.</p>"
          }
        },
        "faq_preorders": {
          "type": "question",
          "settings": {
            "question": "How do pre-orders work?",
            "answer": "<p>Pre-orders are charged when you order and ship as soon as stock lands, usually ahead of release day. Your price is locked in, and if a distributor shorts our allocation you are refunded in full automatically.</p>"
          }
        }
      },
      "block_order": [
        "faq_authentic",
        "faq_condition",
        "faq_shipping",
        "faq_returns",
        "faq_buying",
        "faq_preorders"
      ]
    },
