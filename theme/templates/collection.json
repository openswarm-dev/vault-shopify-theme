          }
        },
        "link-raw": {
          "type": "link",
          "settings": {
            "label": "Raw singles",
            "link": "/collections/all/raw",
            "highlight": false
          }
        },
        "link-sealed": {
          "type": "link",
          "settings": {
            "label": "Sealed product",
            "link": "/collections/all/sealed",
            "highlight": false
          }
        },
        "link-holo": {
          "type": "link",
          "settings": {
            "label": "Holo & foil",
            "link": "/collections/all/holo",
            "highlight": false
          }
        },
        "link-under-50": {
          "type": "link",
          "settings": {
            "label": "Under $50",
            "link": "/collections/all?filter.v.price.lte=50",
            "highlight": true
          }
        }
      },
      "block_order": [
        "link-graded",
        "link-raw",
        "link-sealed",
        "link-holo",
        "link-under-50"
