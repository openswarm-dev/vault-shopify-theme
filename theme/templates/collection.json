        "columns_mobile": "2",
        "show_density": true,
        "pagination_type": "load_more",
        "image_ratio": "default",
        "show_quick_add": true,
        "enable_filtering": true,
        "filter_layout": "sidebar",
        "filters_open": 3,
        "show_more_limit": 6,
        "enable_sorting": true,
        "color_scheme": "scheme-1",
        "padding_top": 20,
        "padding_bottom": 100
