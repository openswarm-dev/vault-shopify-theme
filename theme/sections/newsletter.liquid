{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign form_id = 'Newsletter-' | append: section.id
  assign input_id = 'NewsletterEmail-' | append: section.id
  assign error_id = 'NewsletterError-' | append: section.id
  assign heading_id = 'NewsletterHeading-' | append: section.id
  assign client_error_id = 'NewsletterClientError-' | append: section.id
  assign button_label = 'general.newsletter.button' | t
  if s.button_label != blank
    assign button_label = s.button_label
  endif
-%}

<section
  id="Section-{{ section.id }}"
  class="section section-newsletter newsletter{% if s.animated_border %} newsletter--animated{% endif %}{% if s.background_image != blank %} newsletter--has-image{% endif %} color-{{ s.color_scheme }} section-bg"
  style="--pt: {{ s.padding_top | divided_by: 100.0 }}; --pb: {{ s.padding_bottom | divided_by: 100.0 }};"
  data-section-id="{{ section.id }}"
  data-parallax-root
  {% if s.heading != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
>
  {%- if s.background_image != blank -%}
    <div class="newsletter__bg" aria-hidden="true">
      {{- s.background_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: '', class: 'newsletter__bg-img' -}}
      <span class="newsletter__bg-overlay" style="--nl-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};"></span>
    </div>
  {%- else -%}
    <div class="newsletter__fx" aria-hidden="true"></div>
  {%- endif -%}

  {%- if s.show_cards -%}
    <div class="newsletter__cards" aria-hidden="true">
      <div class="newsletter__card newsletter__card--left" data-parallax="0.1">
        <div class="newsletter__card-inner">
          {%- render 'placeholder-card', variant: 3, uid: section.id -%}
        </div>
      </div>
      <div class="newsletter__card newsletter__card--right" data-parallax="-0.08">
        <div class="newsletter__card-inner">
          {%- render 'placeholder-card', variant: 5, uid: section.id -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="page-width">
    <div class="newsletter__frame" data-reveal="scale">
      <span class="newsletter__glow" aria-hidden="true"></span>
      <div class="newsletter__panel">
        <span class="newsletter__border" aria-hidden="true"></span>
        <div class="newsletter__content">
          {%- if s.eyebrow != blank -%}
            <p class="eyebrow newsletter__eyebrow" data-reveal="fade">{{ s.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 id="{{ heading_id }}" class="newsletter__heading {{ s.heading_size }}" data-split>{{ s.heading }}</h2>
          {%- endif -%}
          {%- if s.text != blank -%}
            <div class="newsletter__text rte" data-reveal>{{ s.text }}</div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ul class="newsletter__perks" role="list">
              {%- for block in section.blocks -%}
                <li class="newsletter__perk" data-reveal="fade-up" {{ block.shopify_attributes }}>
                  {%- render 'icon', name: block.settings.icon, size: 16 -%}
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <newsletter-form class="newsletter__form-wrap" data-reveal>
            {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <div class="newsletter__success" role="status">
                  <span class="newsletter__success-icon" aria-hidden="true">
                    {%- render 'icon', name: 'check', size: 26, stroke: 2.25 -%}
                  </span>
                  <span class="newsletter__success-body">
                    <span class="newsletter__success-title">{{ 'sections.newsletter.success_title' | t }}</span>
                    <span class="newsletter__success-text">{{ 'general.newsletter.success' | t }}</span>
                  </span>
                </div>
              {%- else -%}
                <div class="newsletter__row">
                  <div class="field newsletter__field">
                    <input
                      id="{{ input_id }}"
                      class="field__input newsletter__input"
                      type="email"
                      name="contact[email]"
                      value="{{ form.email }}"
                      placeholder=" "
                      autocomplete="email"
                      autocapitalize="off"
                      autocorrect="off"
                      spellcheck="false"
                      inputmode="email"
                      enterkeyhint="send"
                      required
                      aria-required="true"
                      {% if form.errors %}aria-invalid="true" aria-describedby="{{ error_id }}"{% endif %}
                    >
                    <label class="field__label" for="{{ input_id }}">{{ 'general.newsletter.email_label' | t }}</label>
                  </div>
                  <button type="submit" class="btn btn--primary newsletter__submit" name="commit">
                    <span>{{ button_label | escape }}</span>
                    {%- render 'icon', name: 'arrow-right', size: 18 -%}
                  </button>
                </div>
                {%- if form.errors -%}
                  <div id="{{ error_id }}" class="form-message form-message--error newsletter__message" role="alert">
                    {%- render 'icon', name: 'alert', size: 16 -%}
                    <span>
                      {%- for field in form.errors -%}
                        {%- if field == 'form' -%}
                          {{ form.errors.messages[field] }}
                        {%- else -%}
                          {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                        {%- endif -%}
                        {%- unless forloop.last %} {% endunless -%}
                      {%- endfor -%}
                    </span>
                  </div>
                {%- endif -%}
                <div id="{{ client_error_id }}" class="form-message form-message--error newsletter__message" role="alert" hidden>
                  {%- render 'icon', name: 'alert', size: 16 -%}
                  <span data-error-text></span>
                </div>
              {%- endif -%}
            {%- endform -%}
          </newsletter-form>

          {%- if s.privacy_text != blank -%}
            <p class="newsletter__privacy" data-reveal="fade">
              {%- render 'icon', name: 'lock', size: 14 -%}
              <span>{{ s.privacy_text }}</span>
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'section-newsletter.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Vault list" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italicize words to highlight them in the accent color.",
      "default": "Get first dibs on <em>drops</em>"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h0", "label": "Extra large" },
        { "value": "h1", "label": "Large" },
        { "value": "h2", "label": "Medium" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>New sets, restocks and graded pickups hit the list 24 hours before the store. No spam, just cards.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the list" },
    {
      "type": "inline_richtext",
      "id": "privacy_text",
      "label": "Privacy note",
      "default": "One or two emails a week. Unsubscribe anytime."
    },
    { "type": "header", "content": "Style" },
    { "type": "checkbox", "id": "animated_border", "label": "Animated glowing border", "default": true },
    { "type": "checkbox", "id": "show_cards", "label": "Show floating cards", "default": true },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 10, "unit": "%", "label": "Background image overlay", "default": 60 },
    { "type": "header", "content": "Colors & spacing" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 150, "step": 10, "unit": "%", "label": "Top padding", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 150, "step": 10, "unit": "%", "label": "Bottom padding", "default": 100 }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "clock", "label": "Clock" },
            { "value": "flame", "label": "Flame" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "star", "label": "Star" },
            { "value": "gift", "label": "Gift" },
            { "value": "tag", "label": "Price tag" },
            { "value": "cards", "label": "Cards" },
            { "value": "trophy", "label": "Trophy" },
            { "value": "lock", "label": "Lock" },
            { "value": "mail", "label": "Mail" }
          ],
          "default": "bolt"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "24h early access" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Newsletter",
      "settings": { "color_scheme": "scheme-2" },
      "blocks": [
        { "type": "perk", "settings": { "icon": "bolt", "text": "24h early access" } },
        { "type": "perk", "settings": { "icon": "flame", "text": "Restock alerts" } },
        { "type": "perk", "settings": { "icon": "gift", "text": "Subscriber giveaways" } }
      ]
    }
  ]
}
{% endschema %}
