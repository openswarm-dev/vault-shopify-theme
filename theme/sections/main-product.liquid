          "options": [
            { "value": "verified", "label": "Verified seal" },
            { "value": "shield", "label": "Shield" },
            { "value": "box", "label": "Box" },
            { "value": "cards", "label": "Cards" },
            { "value": "truck", "label": "Truck" },
            { "value": "lock", "label": "Lock" },
            { "value": "award", "label": "Award" },
            { "value": "return", "label": "Return" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "clock", "label": "Clock" }
          ],
          "default": "verified"
        },
        { "type": "text", "id": "title_1", "label": "First title", "default": "Authenticity guaranteed" },
        { "type": "text", "id": "text_1", "label": "First text", "default": "Inspected under loupe and UV" },
        {
          "type": "select",
          "id": "icon_2",
          "label": "Second icon",
          "options": [
            { "value": "verified", "label": "Verified seal" },
            { "value": "shield", "label": "Shield" },
            { "value": "box", "label": "Box" },
            { "value": "cards", "label": "Cards" },
            { "value": "truck", "label": "Truck" },
            { "value": "lock", "label": "Lock" },
            { "value": "award", "label": "Award" },
            { "value": "return", "label": "Return" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "clock", "label": "Clock" }
          ],
          "default": "cards"
        },
        { "type": "text", "id": "title_2", "label": "Second title", "default": "Ships in top-loader + team bag" },
        { "type": "text", "id": "text_2", "label": "Second text", "default": "Slabs travel in bubble sleeves" },
        {
          "type": "select",
          "id": "icon_3",
          "label": "Third icon",
          "options": [
            { "value": "verified", "label": "Verified seal" },
            { "value": "shield", "label": "Shield" },
            { "value": "box", "label": "Box" },
            { "value": "cards", "label": "Cards" },
            { "value": "truck", "label": "Truck" },
            { "value": "lock", "label": "Lock" },
            { "value": "award", "label": "Award" },
            { "value": "return", "label": "Return" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "clock", "label": "Clock" }
          ],
          "default": "truck"
