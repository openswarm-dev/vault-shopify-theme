    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & protection" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
