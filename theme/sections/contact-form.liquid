{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign form_id = 'ContactForm-' | append: sid
  assign field_prefix = 'ContactForm-' | append: sid | append: '-'

  assign label_name = 'sections.contact_form.name' | t
  assign label_email = 'sections.contact_form.email' | t
  assign label_phone = 'sections.contact_form.phone' | t
  assign label_topic = 'sections.contact_form.topic' | t
  assign label_message = 'sections.contact_form.message' | t

  assign topics_raw = section.settings.topics
  if topics_raw == blank
    assign topics_raw = 'sections.contact_form.topics_default' | t
  endif
  assign topics = topics_raw | split: ','

  assign submit_label = section.settings.button_label
  if submit_label == blank
    assign submit_label = 'sections.contact_form.send' | t
  endif

  assign success_message = section.settings.success_message
  if success_message == blank
    assign success_message = 'sections.contact_form.success' | t
  endif
-%}

<section
  id="Section-{{ sid }}"
  class="section contact-section color-{{ section.settings.color_scheme }} section-bg"
  style="--pt: {{ section.settings.padding_top | divided_by: 100.0 }}; --pb: {{ section.settings.padding_bottom | divided_by: 100.0 }};"
  data-section-id="{{ sid }}"
>
  <div class="page-width">
    {%- assign heading_id = 'ContactHeading-' | append: sid -%}
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      align: section.settings.heading_alignment,
      size: 'h2',
      tag: 'h2',
      id: heading_id
    %}

    <div class="contact{% if section.settings.panel_position == 'left' %} contact--panel-left{% endif %}{% if section.blocks.size == 0 %} contact--solo{% endif %}">
      <contact-form-panel class="contact__card" data-reveal>
        <div class="contact__card-head">
          <h3 class="contact__card-title">{{ 'sections.contact_form.card_title' | t }}</h3>
          {%- if section.settings.response_time != blank -%}
            <span class="contact__pill">
              <span class="contact__pill-dot" aria-hidden="true"></span>
              {{- section.settings.response_time | escape -}}
            </span>
          {%- endif -%}
        </div>

        {%- form 'contact', id: form_id, class: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="form-message form-message--success contact-form__message" role="status" tabindex="-1" data-contact-message>
              {%- render 'icon', name: 'check', size: 18 -%}
              <p>{{ success_message | escape }}</p>
            </div>
          {%- elsif form.errors -%}
            <div class="form-message form-message--error contact-form__message" role="alert" tabindex="-1" data-contact-message>
              {%- render 'icon', name: 'alert', size: 18 -%}
              <div>
                <p>{{ 'sections.contact_form.error_heading' | t }}</p>
                <ul>
                  {%- for field in form.errors -%}
                    <li>
                      {%- if field == 'form' -%}
                        {{ form.errors.messages[field] }}
                      {%- else -%}
                        <a href="#{{ field_prefix }}{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- endif -%}

          <div class="contact-form__grid">
            <div class="field">
              <input
                class="field__input"
                type="text"
                id="{{ field_prefix }}name"
                name="contact[{{ label_name }}]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                autocomplete="name"
                placeholder=" "
              >
              <label class="field__label" for="{{ field_prefix }}name">{{ label_name }}</label>
            </div>

            <div class="field">
              <input
                class="field__input"
                type="email"
                id="{{ field_prefix }}email"
                name="contact[email]"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                placeholder=" "
                required
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true" aria-describedby="{{ field_prefix }}email-error"
                {% endif %}
              >
              <label class="field__label" for="{{ field_prefix }}email">{{ label_email }} <span aria-hidden="true">*</span></label>
              {%- if form.errors contains 'email' -%}
                <p class="contact-form__field-error" id="{{ field_prefix }}email-error">
                  {%- render 'icon', name: 'alert', size: 14 -%}
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
            </div>

            {%- if section.settings.show_phone -%}
              <div class="field">
                <input
                  class="field__input"
                  type="tel"
                  id="{{ field_prefix }}phone"
                  name="contact[{{ label_phone }}]"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  autocomplete="tel"
                  pattern="[0-9\-\+\s\(\)]*"
                  placeholder=" "
                >
                <label class="field__label" for="{{ field_prefix }}phone">{{ label_phone }}</label>
              </div>
            {%- endif -%}

            {%- if section.settings.show_topic and topics.size > 0 -%}
              <div class="field field--select{% unless section.settings.show_phone %} contact-form__full{% endunless %}">
                <select class="field__input field__select" id="{{ field_prefix }}topic" name="contact[{{ label_topic }}]">
                  {%- for topic in topics -%}
                    {%- assign topic_clean = topic | strip -%}
                    {%- if topic_clean != blank -%}
                      <option value="{{ topic_clean | escape }}">{{ topic_clean | escape }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
                <label class="field__label" for="{{ field_prefix }}topic">{{ label_topic }}</label>
                {%- render 'icon', name: 'chevron-down', size: 18, class: 'field__chevron' -%}
              </div>
            {%- endif -%}

            <div class="field contact-form__full">
              <textarea
                class="field__input"
                id="{{ field_prefix }}body"
                name="contact[body]"
                rows="6"
                placeholder=" "
                required
                aria-required="true"
                {% if form.errors contains 'body' %}
                  aria-invalid="true" aria-describedby="{{ field_prefix }}body-error"
                {% endif %}
              >{{ form.body }}</textarea>
              <label class="field__label" for="{{ field_prefix }}body">{{ label_message }} <span aria-hidden="true">*</span></label>
              {%- if form.errors contains 'body' -%}
                <p class="contact-form__field-error" id="{{ field_prefix }}body-error">
                  {%- render 'icon', name: 'alert', size: 14 -%}
                  {{ form.errors.translated_fields.body | capitalize }} {{ form.errors.messages.body }}
                </p>
              {%- endif -%}
            </div>
          </div>

          <div class="contact-form__footer">
            <p class="contact-form__note">{{ 'sections.contact_form.required_note' | t }}</p>
            <button type="submit" class="btn btn--primary btn--lg contact-form__submit" data-contact-submit>
              <span>{{ submit_label | escape }}</span>
              {%- render 'icon', name: 'arrow-right', size: 18 -%}
            </button>
          </div>
        {%- endform -%}
      </contact-form-panel>

      {%- if section.blocks.size > 0 -%}
        <aside class="contact__aside" aria-label="{{ 'sections.contact_form.aside_label' | t }}">
          <ul class="contact__items" role="list">
            {%- for block in section.blocks -%}
              <li class="contact-item" data-reveal data-spotlight {{ block.shopify_attributes }}>
                <span class="contact-item__icon" aria-hidden="true">
                  {%- render 'icon', name: block.settings.icon, size: 22 -%}
                </span>
                <div class="contact-item__body">
                  {%- if block.settings.title != blank -%}
                    <h3 class="contact-item__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="contact-item__text">{{ block.settings.text }}</div>
                  {%- endif -%}
                  {%- if block.settings.link != blank and block.settings.link_label != blank -%}
                    <a href="{{ block.settings.link }}" class="link link--accent contact-item__link">
                      {{- block.settings.link_label | escape -}}
                      {%- render 'icon', name: 'arrow-up-right', size: 16 -%}
                    </a>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </aside>
      {%- endif -%}
    </div>
  </div>
</section>

<script src="{{ 'section-contact-form.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Contact form",
  "class": "shopify-section--contact-form",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Talk to a collector"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Questions? Ask the <em>vault</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Order help, grading advice or a binder you want to sell: real collectors read every message.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Response time badge",
      "default": "Replies within 24 hours"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone field",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_topic",
      "label": "Show topic dropdown",
      "default": true
    },
    {
      "type": "text",
      "id": "topics",
      "label": "Topics",
      "info": "Separate with commas.",
      "default": "General question, Selling a collection, Order help, Grading question"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Message received. A member of the team will reply within one business day."
    },
    {
      "type": "select",
      "id": "panel_position",
      "label": "Contact details position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Colors & spacing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "%",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "%",
      "label": "Bottom padding",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "contact_item",
      "name": "Contact detail",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "mail", "label": "Email" },
            { "value": "chat", "label": "Chat" },
            { "value": "phone", "label": "Phone" },
            { "value": "clock", "label": "Clock" },
            { "value": "map-pin", "label": "Location" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Shipping" },
            { "value": "award", "label": "Award" },
            { "value": "cards", "label": "Cards" },
            { "value": "box", "label": "Box" }
          ],
          "default": "mail"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Email the team"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Order questions, trade-ins and grading advice. We reply within one business day.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "blocks": [
        {
          "type": "contact_item",
          "settings": {
            "icon": "mail",
            "title": "Email the team",
            "text": "<p>Order questions, trade-ins and grading advice. We reply within one business day.</p>"
          }
        },
        {
          "type": "contact_item",
          "settings": {
            "icon": "chat",
            "title": "Join the Discord",
            "text": "<p>Live pull streams, trade nights and restock alerts before anyone else.</p>"
          }
        },
        {
          "type": "contact_item",
          "settings": {
            "icon": "clock",
            "title": "Support hours",
            "text": "<p>Monday to Friday, 9am to 6pm. Saturday, 10am to 4pm.</p>"
          }
        },
        {
          "type": "contact_item",
          "settings": {
            "icon": "map-pin",
            "title": "Local pickup",
            "text": "<p>Collect graded slabs in person by appointment. Address shared after booking.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
