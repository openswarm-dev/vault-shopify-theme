{{ 'section-main-password.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign modal_id = 'PasswordModal-' | append: sid
  assign newsletter_id = 'PasswordNewsletter-' | append: sid

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'templates.password.heading_html' | t
  endif

  assign message = shop.password_message | strip
  if message == blank
    assign message = section.settings.text
  endif

  assign launch_ts = ''
  if section.settings.launch_date != blank
    assign launch_ts = section.settings.launch_date | date: '%s'
  endif

  assign ticker_items = section.settings.ticker | split: ','

  assign signup_label = section.settings.button_label
  if signup_label == blank
    assign signup_label = 'general.newsletter.button' | t
  endif

  assign logo_sizes = '(min-width: 750px) ' | append: settings.logo_width | append: 'px, ' | append: settings.logo_width_mobile | append: 'px'
-%}

{%- capture password_form -%}
  {%- form 'storefront_password', class: 'pw-modal__form' -%}
    {%- if form.errors -%}
      {%- assign pw_has_error = true -%}
      <div class="form-message form-message--error" role="alert" id="PasswordError-{{ sid }}">
        {%- render 'icon', name: 'alert', size: 18 -%}
        <div>{{ form.errors | default_errors }}</div>
      </div>
    {%- endif -%}
    <div class="field">
      <input
        type="password"
        name="password"
        id="Password-{{ sid }}"
        class="field__input"
        autocomplete="current-password"
        placeholder=" "
        required
        aria-required="true"
        data-drawer-focus
        {% if form.errors %}
          aria-invalid="true" aria-describedby="PasswordError-{{ sid }}"
        {% endif %}
      >
      <label class="field__label" for="Password-{{ sid }}">{{ 'templates.password.password_label' | t }}</label>
    </div>
    <button type="submit" class="btn btn--primary btn--lg btn--block">
      <span>{{ 'templates.password.enter' | t }}</span>
      {%- render 'icon', name: 'arrow-right', size: 18 -%}
    </button>
  {%- endform -%}
{%- endcapture -%}

<section
  id="Section-{{ sid }}"
  class="section main-password color-{{ section.settings.color_scheme }} section-bg"
  data-section-id="{{ sid }}"
>
  <div class="pw-bg" aria-hidden="true">
    <span class="pw-bg__grid"></span>
    <span class="pw-bg__glow"></span>
    <span class="pw-bg__beam"></span>
  </div>

  <password-teaser class="pw" data-section-id="{{ sid }}">
    <header class="page-width pw__bar">
      <div class="pw__brand">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt | default: shop.name -%}
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              class: 'pw__logo',
              widths: '150, 300, 450, 600',
              sizes: logo_sizes,
              alt: logo_alt,
              loading: 'eager'
          }}
        {%- else -%}
          <span class="pw__wordmark">{{ shop.name | escape }}</span>
        {%- endif -%}
      </div>
      <a
        href="#{{ modal_id }}-panel"
        class="btn btn--secondary btn--sm pw__owner"
        data-drawer-open="{{ modal_id }}"
        aria-controls="{{ modal_id }}"
        aria-expanded="false"
      >
        {%- render 'icon', name: 'lock', size: 16 -%}
        <span class="pw__owner-long">{{ 'templates.password.owner_button' | t }}</span>
        <span class="pw__owner-short">{{ 'templates.password.owner_button_short' | t }}</span>
      </a>
    </header>

    <div class="page-width pw__hero">
      <div class="pw__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pw__status" data-reveal="fade">
            <span class="pw__status-dot" aria-hidden="true"></span>
            {{- section.settings.eyebrow | escape -}}
          </p>
        {%- endif -%}
        <h1 class="h0 pw__title" data-split>{{ heading }}</h1>
        {%- if message != blank -%}
          <div class="lead pw__message" data-reveal>{{ message }}</div>
        {%- endif -%}

        {%- if launch_ts != blank -%}
          <div class="pw-countdown" data-countdown="{{ launch_ts }}" data-reveal>
            <p class="pw-countdown__label">{{ 'templates.password.countdown_label' | t }}</p>
            <div class="pw-countdown__tiles" role="timer" aria-live="off" aria-label="{{ 'templates.password.countdown_label' | t }}">
              <div class="pw-countdown__tile">
                <span class="pw-countdown__num" data-unit="days">--</span>
                <span class="pw-countdown__unit">{{ 'templates.password.days' | t }}</span>
              </div>
              <div class="pw-countdown__tile">
                <span class="pw-countdown__num" data-unit="hours">--</span>
                <span class="pw-countdown__unit">{{ 'templates.password.hours' | t }}</span>
              </div>
              <div class="pw-countdown__tile">
                <span class="pw-countdown__num" data-unit="minutes">--</span>
                <span class="pw-countdown__unit">{{ 'templates.password.minutes' | t }}</span>
              </div>
              <div class="pw-countdown__tile">
                <span class="pw-countdown__num" data-unit="seconds">--</span>
                <span class="pw-countdown__unit">{{ 'templates.password.seconds' | t }}</span>
              </div>
            </div>
            <p class="pw-countdown__date">
              {%- render 'icon', name: 'calendar', size: 16 -%}
              <time datetime="{{ section.settings.launch_date | date: '%Y-%m-%dT%H:%M' }}">{{ section.settings.launch_date | date: '%B %-d, %Y · %H:%M' }}</time>
            </p>
          </div>
        {%- endif -%}

        {%- if section.settings.show_newsletter -%}
          <div class="pw-signup" data-reveal>
            {%- form 'customer', id: newsletter_id, class: 'pw-signup__form' -%}
              <input type="hidden" name="contact[tags]" value="password-page">
              {%- if form.posted_successfully? -%}
                <div class="form-message form-message--success" role="status" tabindex="-1" data-signup-message>
                  {%- render 'icon', name: 'check', size: 18 -%}
                  <p>{{ 'general.newsletter.success' | t }}</p>
                </div>
              {%- elsif form.errors -%}
                <div class="form-message form-message--error" role="alert" tabindex="-1" data-signup-message id="{{ newsletter_id }}-error">
                  {%- render 'icon', name: 'alert', size: 18 -%}
                  <div>{{ form.errors | default_errors }}</div>
                </div>
              {%- endif -%}
              {%- unless form.posted_successfully? -%}
                <div class="pw-signup__row">
                  <div class="field pw-signup__field">
                    <input
                      class="field__input"
                      type="email"
                      id="{{ newsletter_id }}-email"
                      name="contact[email]"
                      autocomplete="email"
                      autocapitalize="off"
                      spellcheck="false"
                      placeholder=" "
                      required
                      aria-required="true"
                      {% if form.errors %}
                        aria-invalid="true" aria-describedby="{{ newsletter_id }}-error"
                      {% endif %}
                    >
                    <label class="field__label" for="{{ newsletter_id }}-email">{{ 'general.newsletter.email_label' | t }}</label>
                  </div>
                  <button type="submit" class="btn btn--primary btn--lg pw-signup__btn">
                    {%- render 'icon', name: 'bolt', size: 18 -%}
                    <span>{{ signup_label | escape }}</span>
                  </button>
                </div>
              {%- endunless -%}
              {%- if section.settings.fine_print != blank -%}
                <p class="pw-signup__fine">{{ section.settings.fine_print | escape }}</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pw__visual" aria-hidden="true">
        <div class="pw-fan" data-fan>
          {%- assign fan_variants = '3,4,1,6,5' | split: ',' -%}
          {%- for v in fan_variants -%}
            {%- assign fan_uid = 'pw-' | append: sid | append: '-' | append: forloop.index -%}
            <div class="pw-fan__card pw-fan__card--{{ forloop.index }}">
              <div class="pw-fan__lift" data-fan-card>
                {%- if forloop.index == 3 -%}
                  <holo-card data-foil="intense" data-tilt="false">
                    <div class="holo">
                      {% render 'placeholder-card', variant: v, uid: fan_uid %}
                      <span class="holo__shine"></span>
                      <span class="holo__glare"></span>
                    </div>
                  </holo-card>
                {%- else -%}
                  {% render 'placeholder-card', variant: v, uid: fan_uid %}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- if section.settings.show_ticker and ticker_items.size > 0 -%}
      <div class="pw__ticker" aria-hidden="true">
        <vault-marquee data-speed="36" data-fade>
          <div class="marquee__track">
            <div class="marquee__group">
              {%- for item in ticker_items -%}
                {%- assign ticker_text = item | strip -%}
                {%- if ticker_text != blank -%}
                  <span class="pw__ticker-item">{{ ticker_text | escape }}</span>
                  <span class="pw__ticker-dot"></span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </vault-marquee>
      </div>
    {%- endif -%}

    <footer class="page-width pw__footer">
      {% render 'social-icons', class: 'pw__social' %}
      <p class="pw__legal">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
        <span aria-hidden="true">&middot;</span>
        {{ powered_by_link }}
      </p>
    </footer>
  </password-teaser>

  <vault-drawer
    id="{{ modal_id }}"
    class="pw-modal"
    data-placement="center"
    data-mobile-placement="bottom"
    style="--modal-width: 460px;"
    {% if pw_has_error %}
      data-open-on-load
    {% endif %}
  >
    <dialog class="drawer" aria-labelledby="{{ modal_id }}-title">
      <div class="drawer__overlay" data-drawer-close></div>
      <div class="drawer__panel pw-modal__panel" id="{{ modal_id }}-panel">
        <div class="drawer__handle" data-drawer-handle></div>
        <div class="drawer__header">
          <h2 class="drawer__title" id="{{ modal_id }}-title">{{ 'templates.password.modal_title' | t }}</h2>
          <button type="button" class="btn btn--ghost btn--icon pw-modal__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
            {%- render 'icon', name: 'close', size: 20 -%}
          </button>
        </div>
        <div class="drawer__body pw-modal__body">
          <div class="pw-modal__intro" data-drawer-item>
            <span class="pw-modal__icon" aria-hidden="true">{% render 'icon', name: 'lock', size: 22 %}</span>
            <p>{{ 'templates.password.modal_text' | t }}</p>
          </div>
          <div data-drawer-item>{{ password_form }}</div>
          <p class="pw-modal__admin" data-drawer-item>{{ 'templates.password.admin_link_html' | t }}</p>
        </div>
      </div>
    </dialog>
  </vault-drawer>
</section>

<script src="{{ 'section-main-password.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Password page",
  "class": "shopify-section--main-password",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Status label",
      "default": "Drop incoming"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The vault <em>opens</em> soon"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Message",
      "info": "Used when the password page message in Online Store > Preferences is empty.",
      "default": "<p>Graded grails, sealed booster boxes and fresh singles are being sleeved, slabbed and catalogued. Get on the list for first access when the doors open.</p>"
    },
    {
      "type": "text",
      "id": "launch_date",
      "label": "Launch date and time",
      "info": "Shows a live countdown. Format: 2026-11-28 18:00 (store time zone). Leave blank to hide."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email signup",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "No spam. Just drops, restocks and members-only pricing."
    },
    {
      "type": "header",
      "content": "Ticker"
    },
    {
      "type": "checkbox",
      "id": "show_ticker",
      "label": "Show scrolling ticker",
      "default": true
    },
    {
      "type": "text",
      "id": "ticker",
      "label": "Ticker items",
      "info": "Separate with commas.",
      "default": "Pokémon, Magic: The Gathering, Yu-Gi-Oh!, One Piece, Lorcana, Sports cards, Graded slabs, Sealed product"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
