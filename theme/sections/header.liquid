{%- comment -%}
  Global header (header group).
  - Root <header data-header>: core turns its height into --header-height.
  - Sticky: always | scroll_up (hides on scroll down past ~200px, springs back on scroll up) | none.
  - Transparent at the top → frosted glass once scrolled; optional overlay over the first home section.
  - Desktop ≥990: logo · centred nav (dropdowns + mega menus, shared spring indicator) · icons.
  - <990: animated burger → MenuDrawer; search → SearchDrawer (command palette).
  - Mobile dock (<750) when settings.mobile_dock and not on product pages.
  JS: section-header.js (<vault-header>), component-menu-drawer.js, component-predictive-search.js,
      component-mobile-dock.js.
{%- endcomment -%}
{%- liquid
  assign menu = section.settings.menu
  assign overlay = false
  if section.settings.transparent_home and template.name == 'index'
    assign overlay = true
  endif
  assign show_dock = false
  if settings.mobile_dock and template.name != 'product'
    assign show_dock = true
  endif

  # Promo blocks already rendered (with editor attributes) inside a desktop mega menu.
  assign promo_matched = ''
  for link in menu.links
    if link.links.size > 0
      assign link_key = link.title | strip | downcase
      for block in section.blocks
        assign promo_key = block.settings.menu_item | strip | downcase
        if block.type == 'mega_promo' and promo_key != blank and promo_key == link_key
          assign promo_matched = promo_matched | append: ',' | append: block.id | append: ','
        endif
      endfor
    endif
  endfor
  assign first_promo = section.blocks | where: 'type', 'mega_promo' | first
-%}

{{ 'section-header.css' | asset_url | stylesheet_tag }}
{{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}
{{ 'component-predictive-search.css' | asset_url | stylesheet_tag }}
{%- if show_dock -%}
  {{ 'component-mobile-dock.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    position: {% if section.settings.sticky == 'none' %}relative{% else %}sticky{% endif %};
    top: 0;
    z-index: var(--z-header);
    pointer-events: none;
    {%- if overlay %}
      margin-bottom: calc(var(--header-height) * -1);
    {%- endif %}
  }
{%- endstyle -%}

<vault-header
  class="vault-header color-{{ section.settings.color_scheme }}"
  data-sticky="{{ section.settings.sticky }}"
  {% if overlay %}
    data-overlay
  {% endif %}
>
  <header class="header{% if overlay %} header--overlay{% endif %}" data-header>
    <div class="header__bg" aria-hidden="true"></div>
    {%- if overlay -%}
      <div class="header__scrim" aria-hidden="true"></div>
    {%- endif -%}

    <div class="header__inner page-width">
      <div class="header__start">
        <a
          href="#MenuDrawer"
          class="header__icon burger header__burger"
          data-drawer-open="MenuDrawer"
          aria-controls="MenuDrawer"
          aria-expanded="false"
        >
          <span class="burger__box" aria-hidden="true">
            <span class="burger__line"></span>
            <span class="burger__line"></span>
            <span class="burger__line"></span>
          </span>
          <span class="visually-hidden">{{ 'accessibility.open_menu' | t }}</span>
        </a>
      </div>

      <div class="header__brand">
        {%- render 'header-logo', class: 'header__logo', eager: true -%}
      </div>

      {%- if menu.links.size > 0 -%}
        <nav class="header__nav" aria-label="{{ 'sections.header.navigation' | t }}">
          {%- render 'header-nav', menu: menu, section: section -%}
        </nav>
      {%- endif -%}

      <div class="header__end">
        <a
          href="{{ routes.search_url }}"
          class="header__icon header__search"
          data-drawer-open="SearchDrawer"
          aria-controls="SearchDrawer"
          aria-expanded="false"
        >
          {%- render 'icon', name: 'search', size: 22 -%}
          <span class="header__search-label">{{ 'accessibility.search' | t }}</span>
          <kbd class="header__kbd" data-search-kbd aria-hidden="true" hidden>⌘K</kbd>
        </a>

        {%- comment -%}
          Phones keep the bar to search + cart so the wordmark has room on every template;
          the account link lives in the dock and at the top of the menu drawer.
        {%- endcomment -%}
        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            class="header__icon header__account hide-mobile"
          >
            {%- render 'icon', name: 'user', size: 22 -%}
            <span class="visually-hidden">
              {%- if customer -%}
                {{- 'sections.header.my_account' | t -}}
              {%- else -%}
                {{- 'sections.header.log_in' | t -}}
              {%- endif -%}
            </span>
          </a>
        {%- endif -%}

        <a
          href="{{ routes.cart_url }}"
          id="cart-icon-bubble"
          class="header__icon header__cart"
          data-cart-icon
          {% if settings.cart_type == 'drawer' %}
            data-drawer-open="CartDrawer"
            aria-controls="CartDrawer"
            aria-expanded="false"
          {% endif %}
        >
          <span class="visually-hidden">{{ 'accessibility.cart' | t }}</span>
          {%- render 'icon', name: 'cart', size: 22 -%}
          {%- render 'header-cart-count' -%}
        </a>
      </div>
    </div>
  </header>

  {%- render 'header-menu-drawer',
    section: section,
    menu: menu,
    first_promo: first_promo,
    promo_matched: promo_matched
  -%}
  {%- render 'header-search-drawer', section: section, menu: menu -%}
  {%- if show_dock -%}
    {%- render 'header-mobile-dock', menu: menu -%}
  {%- endif -%}
</vault-header>

<script src="{{ 'section-header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-menu-drawer.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-predictive-search.js' | asset_url }}" defer="defer"></script>
{%- if show_dock -%}
  <script src="{{ 'component-mobile-dock.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "vault-header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Items with nested links open a mega menu on desktop."
    },
    {
      "type": "select",
      "id": "sticky",
      "label": "Sticky header",
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "scroll_up", "label": "On scroll up" },
        { "value": "none", "label": "None" }
      ],
      "default": "scroll_up"
    },
    {
      "type": "checkbox",
      "id": "transparent_home",
      "label": "Transparent over the first section on the home page",
      "info": "Turns frosted glass as soon as the page scrolls.",
      "default": true
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "text",
      "id": "search_popular",
      "label": "Popular searches",
      "info": "Separate searches with commas. Shown when the search palette opens.",
      "default": "Charizard, PSA 10, Booster box, Moonbreon, One Piece OP-09, Black Lotus"
    },
    {
      "type": "header",
      "content": "Mobile menu"
    },
    {
      "type": "checkbox",
      "id": "drawer_show_promo",
      "label": "Show featured promo",
      "info": "Uses the first mega menu promo block.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "drawer_show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "drawer_show_localization",
      "label": "Show country & language selectors",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "mega_promo",
      "name": "Mega menu promo",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item",
          "info": "Title of the top-level menu item whose mega menu shows this card, e.g. Shop. Up to two cards per menu item.",
          "default": "Shop"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Just landed"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Graded <em>grails</em>"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "PSA 10 and BGS 9.5 slabs, cert-verified and insured to your door."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": "/collections/all"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop now"
        }
      ]
    }
  ]
}
{% endschema %}
