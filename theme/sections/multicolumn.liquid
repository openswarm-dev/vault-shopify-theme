{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign style = s.style
  assign block_count = section.blocks.size

  # Never leave empty columns: cap the column count at the number of blocks.
  assign cols_desktop = s.columns_desktop
  assign cols_tablet = s.columns_tablet | plus: 0
  if block_count > 0 and block_count < cols_desktop
    assign cols_desktop = block_count
  endif
  if block_count > 0 and block_count < cols_tablet
    assign cols_tablet = block_count
  endif
  assign cols_mobile = 1
  if s.columns_mobile == '2'
    assign cols_mobile = 2
  endif

  assign heading_id = 'Heading-' | append: section.id
-%}

<section
  id="Section-{{ section.id }}"
  class="section section-multicolumn multicolumn multicolumn--{{ style }} multicolumn--{{ s.text_align }} color-{{ s.color_scheme }} section-bg"
  style="--pt: {{ s.padding_top | divided_by: 100.0 }}; --pb: {{ s.padding_bottom | divided_by: 100.0 }};"
  data-section-id="{{ section.id }}"
  {% if s.heading != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
>
  <div class="page-width">
    {% render 'section-header',
      eyebrow: s.eyebrow,
      heading: s.heading,
      text: s.text,
      link_label: s.link_label,
      link_url: s.link_url,
      align: s.heading_align,
      size: 'h2',
      tag: 'h2',
      id: heading_id
    %}

    {%- if block_count > 0 -%}
      <ul
        class="multicolumn__list{% if s.columns_mobile == 'scroll' %} multicolumn__list--scroll{% endif %}"
        role="list"
        style="--mc-cols-mobile: {{ cols_mobile }}; --mc-cols-tablet: {{ cols_tablet }}; --mc-cols-desktop: {{ cols_desktop }};"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign number = forloop.index | prepend: '0' | slice: -2, 2
            if forloop.index > 99
              assign number = forloop.index
            endif
            assign has_link = false
            if b.link != blank
              assign has_link = true
            endif
          -%}
          <li class="multicolumn__item" data-reveal="fade-up" {{ block.shopify_attributes }}>
            <div class="multicolumn__card{% if has_link %} multicolumn__card--linked{% endif %}"{% if style == 'cards' %} data-spotlight{% endif %}>
              {%- if style == 'numbered' -%}
                <span class="multicolumn__number" aria-hidden="true">{{ number }}</span>
              {%- endif -%}

              {%- if b.image != blank -%}
                <span class="multicolumn__icon multicolumn__icon--image">
                  {{- b.image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '56px', alt: '' -}}
                </span>
              {%- elsif b.icon != 'none' and style != 'numbered' -%}
                <span class="multicolumn__icon">
                  {%- render 'icon', name: b.icon, size: 22 -%}
                </span>
              {%- endif -%}

              <div class="multicolumn__body">
                {%- if b.title != blank -%}
                  <h3 class="multicolumn__title">
                    {%- if has_link and b.link_label == blank -%}
                      <a href="{{ b.link }}" class="multicolumn__link">{{ b.title | escape }}</a>
                    {%- else -%}
                      {{- b.title | escape -}}
                    {%- endif -%}
                  </h3>
                {%- endif -%}
                {%- if b.text != blank -%}
                  <div class="multicolumn__text rte">{{ b.text }}</div>
                {%- endif -%}
                {%- if has_link and b.link_label != blank -%}
                  <a href="{{ b.link }}" class="multicolumn__cta multicolumn__link link link--accent">
                    {{- b.link_label | escape -}}
                    {%- render 'icon', name: 'arrow-right', size: 16 -%}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Multicolumn",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    {
