{{ 'component-page-head.css' | asset_url | stylesheet_tag }}
{{ 'component-prose.css' | asset_url | stylesheet_tag }}
{{ 'section-main-article.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 220 | at_least: 1
  assign first_tag = article.tags | first

  assign share_url = shop.url | append: article.url
  assign share_url_enc = share_url | url_encode
  assign share_title_enc = article.title | url_encode

  assign prose_class = 'rte prose prose--lead'
  if section.settings.drop_cap
    assign prose_class = prose_class | append: ' prose--dropcap'
  endif
-%}

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

<section
  id="Section-{{ sid }}"
  class="section main-article color-{{ section.settings.color_scheme }} section-bg"
  style="--pt: {{ section.settings.padding_top | divided_by: 100.0 }}; --pb: {{ section.settings.padding_bottom | divided_by: 100.0 }};"
  data-section-id="{{ sid }}"
>
  {%- if section.settings.show_progress -%}
    <div class="article-progress" aria-hidden="true" data-article-progress>
      <span class="article-progress__bar" data-article-progress-bar></span>
    </div>
  {%- endif -%}
  <div class="page-backdrop" aria-hidden="true"></div>

  <main-article
    class="main-article__inner"
    data-section-id="{{ sid }}"
    data-msg-copied="{{ 'blogs.article.share.copied' | t | escape }}"
    data-msg-copy-error="{{ 'blogs.article.share.copy_error' | t | escape }}"
  >
    <article class="main-article__article" aria-labelledby="ArticleTitle-{{ sid }}">
      <header class="article-hero">
        <div class="page-width page-width--narrow article-hero__text">
          <nav class="page-crumb" aria-label="{{ 'blogs.article.breadcrumb' | t }}" data-reveal="fade">
            <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
            {%- if first_tag != blank -%}
              <span class="page-crumb__sep" aria-hidden="true">/</span>
              <a href="{{ blog.url }}/tagged/{{ first_tag | handleize }}">{{ first_tag | escape }}</a>
            {%- endif -%}
          </nav>

          <h1 class="h1 article-hero__title" id="ArticleTitle-{{ sid }}" data-split>{{ article.title | escape }}</h1>

          {%- if section.settings.show_excerpt and article.excerpt != blank -%}
            <p class="lead article-hero__excerpt" data-reveal>{{ article.excerpt | strip_html | truncatewords: 40 }}</p>
          {%- endif -%}

          <div class="article-meta" data-reveal="fade">
            {%- if section.settings.show_author and article.author != blank -%}
              <span class="article-meta__author">
                <span class="article-meta__avatar" aria-hidden="true">{{ article.author | slice: 0 | upcase }}</span>
                <span>{{ 'blogs.article.by_author' | t: author: article.author }}</span>
              </span>
            {%- endif -%}
            {%- if section.settings.show_date -%}
              <span class="article-meta__item">
                {%- render 'icon', name: 'calendar', size: 16 -%}
                {{ article.published_at | time_tag: format: 'date' }}
              </span>
            {%- endif -%}
            {%- if section.settings.show_reading_time -%}
              <span class="article-meta__item">
                {%- render 'icon', name: 'clock', size: 16 -%}
                {{ 'blogs.article.read_time' | t: count: minutes }}
              </span>
            {%- endif -%}
          </div>
        </div>

        <div class="page-width article-hero__media-wrap">
          {%- if article.image -%}
            <figure
              class="article-hero__media article-hero__media--{{ section.settings.image_height }}"
              style="--img-ratio: {{ article.image.aspect_ratio | default: 1.7778 }};"
              data-parallax-root
              data-reveal="clip"
            >
              <div
                class="article-hero__parallax"
                {% if section.settings.parallax %}
                  data-parallax="0.07"
                {% endif %}
              >
                {%- assign hero_alt = article.image.alt | default: article.title -%}
                {{
                  article.image
                  | image_url: width: 2400
                  | image_tag:
                    loading: 'eager',
                    fetchpriority: 'high',
                    widths: '600, 900, 1200, 1600, 2000, 2400',
                    sizes: '(min-width: 1520px) 1440px, 96vw',
                    alt: hero_alt,
                    class: 'article-hero__img'
                }}
              </div>
            </figure>
          {%- else -%}
            <div class="article-hero__media article-hero__media--art" data-reveal="clip" aria-hidden="true">
              <div class="article-hero__art">
                {%- assign art_uid = 'article-art-a-' | append: sid -%}
                <span class="article-hero__art-card article-hero__art-card--1">{% render 'placeholder-card', variant: 4, uid: art_uid %}</span>
                {%- assign art_uid = 'article-art-b-' | append: sid -%}
                <span class="article-hero__art-card article-hero__art-card--2">{% render 'placeholder-card', variant: 1, uid: art_uid, graded: true %}</span>
                {%- assign art_uid = 'article-art-c-' | append: sid -%}
                <span class="article-hero__art-card article-hero__art-card--3">{% render 'placeholder-card', variant: 6, uid: art_uid %}</span>
              </div>
            </div>
          {%- endif -%}
        </div>
      </header>

      <div class="page-width page-width--narrow article-body">
        <div class="prose-column">
          <div class="{{ prose_class }}" data-article-body>
            {{ article.content }}
          </div>

          {%- if section.settings.show_tags and article.tags.size > 0 -%}
            <ul class="article-tags" role="list" aria-label="{{ 'blogs.article.tags' | t }}">
              {%- for tag in article.tags -%}
                <li>
                  <a class="pill article-tags__pill" href="{{ blog.url }}/tagged/{{ tag | handleize }}">
                    <span aria-hidden="true">#</span>{{ tag | escape }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.show_share -%}
            <div class="article-share">
              <p class="article-share__label">{{ 'blogs.article.share.label' | t }}</p>
              <div class="article-share__actions">
                <button type="button" class="pill article-share__btn" data-share-copy data-url="{{ share_url | escape }}">
                  <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 14a4.2 4.2 0 0 0 6 0l3-3a4.2 4.2 0 0 0-6-6l-1 1"/><path d="M14 10a4.2 4.2 0 0 0-6 0l-3 3a4.2 4.2 0 0 0 6 6l1-1"/></svg>
                  <span data-share-copy-label>{{ 'blogs.article.share.copy' | t }}</span>
                </button>
                <button type="button" class="pill article-share__btn" data-share-native data-url="{{ share_url | escape }}" data-title="{{ article.title | escape }}" hidden>
                  <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 15V3.5M7.5 8 12 3.5 16.5 8"/><path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/></svg>
                  <span>{{ 'blogs.article.share.native' | t }}</span>
                </button>
                <a class="pill article-share__btn" href="https://x.com/intent/post?text={{ share_title_enc }}&amp;url={{ share_url_enc }}" target="_blank" rel="noopener">
                  <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M17.6 3h3.1l-6.8 7.8 8 10.2h-6.3l-4.9-6.4L5.1 21H2l7.3-8.3L1.6 3h6.4l4.4 5.9L17.6 3Zm-1.1 16.2h1.7L6.9 4.7H5.1l11.4 14.5Z"/></svg>
                  <span>X</span>
                  <span class="visually-hidden">{{ 'accessibility.new_window' | t }}</span>
                </a>
                <a class="pill article-share__btn" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url_enc }}" target="_blank" rel="noopener">
                  <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.8 21.5v-8.2h2.8l.4-3.3h-3.2V8c0-.9.3-1.6 1.6-1.6h1.7V3.5c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7.6v3.3h2.8v8.2h3.4Z"/></svg>
                  <span>Facebook</span>
                  <span class="visually-hidden">{{ 'accessibility.new_window' | t }}</span>
                </a>
                {%- if article.image -%}
                  {%- assign pin_media = article.image | image_url: width: 1200 | prepend: 'https:' | url_encode -%}
                  <a class="pill article-share__btn" href="https://pinterest.com/pin/create/button/?url={{ share_url_enc }}&amp;media={{ pin_media }}&amp;description={{ share_title_enc }}" target="_blank" rel="noopener">
                    <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.6 2.2-.9 3.4-.2 1 .5 1.8 1.5 1.8 1.8 0 3.2-1.9 3.2-4.7 0-2.4-1.8-4.1-4.3-4.1-2.9 0-4.6 2.2-4.6 4.4 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.2.3-.4.2-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2.1-1.3 2.8A10 10 0 1 0 12 2Z"/></svg>
                    <span>Pinterest</span>
                    <span class="visually-hidden">{{ 'accessibility.new_window' | t }}</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </article>

    {%- if blog.previous_article or blog.next_article -%}
      <nav class="page-width page-width--narrow article-pager" aria-label="{{ 'blogs.article.pager_label' | t }}">
        {%- if blog.previous_article -%}
          <a href="{{ blog.previous_article.url }}" class="article-pager__link article-pager__link--prev" data-spotlight data-reveal>
            <span class="article-pager__dir">
              {%- render 'icon', name: 'arrow-left', size: 16 -%}
              {{- 'blogs.article.previous' | t -}}
            </span>
            <span class="article-pager__title">{{ blog.previous_article.title | escape }}</span>
          </a>
        {%- endif -%}
        {%- if blog.next_article -%}
          <a href="{{ blog.next_article.url }}" class="article-pager__link article-pager__link--next" data-spotlight data-reveal>
            <span class="article-pager__dir">
              {{- 'blogs.article.next' | t -}}
              {%- render 'icon', name: 'arrow-right', size: 16 -%}
            </span>
            <span class="article-pager__title">{{ blog.next_article.title | escape }}</span>
          </a>
        {%- endif -%}
      </nav>
    {%- endif -%}

    <div class="page-width page-width--narrow article-back">
      <a href="{{ blog.url }}" class="link link--muted">
        {%- render 'icon', name: 'arrow-left', size: 16 -%}
        {{- 'blogs.article.back_to_blog' | t: blog: blog.title -}}
      </a>
    </div>

    {%- if blog.comments_enabled? -%}
      {%- assign comments_id = 'Comments-' | append: article.id -%}
      {%- assign comments_anchor = '#' | append: comments_id -%}
      {%- assign comment_form_id = 'CommentForm-' | append: article.id -%}
      <section class="page-width page-width--narrow article-comments" id="{{ comments_id }}" aria-labelledby="{{ comments_id }}-title">
        <h2 class="article-comments__title" id="{{ comments_id }}-title">
          {{- 'blogs.article.comments' | t: count: article.comments_count -}}
        </h2>

        {%- if article.comments_count > 0 -%}
          {%- paginate article.comments by 10 -%}
            <ol class="comments" role="list">
              {%- for comment in article.comments -%}
                <li class="comment" id="comment-{{ comment.id }}">
                  <span class="comment__avatar" aria-hidden="true">{{ comment.author | slice: 0 | upcase }}</span>
                  <div class="comment__main">
                    <p class="comment__meta">
                      <strong>{{ comment.author | escape }}</strong>
                      <span>{{ comment.created_at | time_tag: format: 'date' }}</span>
                    </p>
                    <div class="rte comment__body">{{ comment.content }}</div>
                  </div>
                </li>
              {%- endfor -%}
            </ol>
            {%- if paginate.pages > 1 -%}
              <div class="article-comments__pagination">
                {% render 'pagination', paginate: paginate, anchor: comments_anchor %}
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        {%- endif -%}

        <div class="comment-form-card">
          <h3 class="comment-form-card__title">{{ 'blogs.article.leave_comment' | t }}</h3>
          {%- form 'new_comment', article, id: comment_form_id, class: 'comment-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="form-message form-message--success" role="status">
                {%- render 'icon', name: 'check', size: 18 -%}
                <p>
                  {%- if blog.moderated? -%}
                    {{ 'blogs.article.comment_success_moderated' | t }}
                  {%- else -%}
                    {{ 'blogs.article.comment_success' | t }}
                  {%- endif -%}
                </p>
              </div>
            {%- elsif form.errors -%}
              <div class="form-message form-message--error" role="alert">
                {%- render 'icon', name: 'alert', size: 18 -%}
                <div>
                  <p>{{ 'blogs.article.comment_error' | t }}</p>
                  <ul>
                    {%- for field in form.errors -%}
                      <li>
                        {%- if field == 'form' -%}
                          {{ form.errors.messages[field] }}
                        {%- else -%}
                          {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- endif -%}

            <div class="comment-form__grid">
              <div class="field">
                <input
                  class="field__input"
                  type="text"
                  id="{{ comment_form_id }}-author"
                  name="comment[author]"
                  value="{{ form.author }}"
                  autocomplete="name"
                  placeholder=" "
                  required
                  aria-required="true"
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                  {% endif %}
                >
                <label class="field__label" for="{{ comment_form_id }}-author">{{ 'blogs.article.comment_name' | t }}</label>
              </div>
              <div class="field">
                <input
                  class="field__input"
                  type="email"
                  id="{{ comment_form_id }}-email"
                  name="comment[email]"
                  value="{{ form.email }}"
                  autocomplete="email"
                  autocapitalize="off"
                  spellcheck="false"
                  placeholder=" "
                  required
                  aria-required="true"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                  {% endif %}
                >
                <label class="field__label" for="{{ comment_form_id }}-email">{{ 'blogs.article.comment_email' | t }}</label>
              </div>
              <div class="field comment-form__full">
                <textarea
                  class="field__input"
                  id="{{ comment_form_id }}-body"
                  name="comment[body]"
                  rows="5"
                  placeholder=" "
                  required
                  aria-required="true"
                  {% if form.errors contains 'body' %}
                    aria-invalid="true"
                  {% endif %}
                >{{ form.body }}</textarea>
                <label class="field__label" for="{{ comment_form_id }}-body">{{ 'blogs.article.comment_message' | t }}</label>
              </div>
            </div>

            <div class="comment-form__footer">
              {%- if blog.moderated? -%}
                <p class="comment-form__note">{{ 'blogs.article.comment_moderated_note' | t }}</p>
              {%- endif -%}
              <button type="submit" class="btn btn--primary">
                <span>{{ 'blogs.article.post_comment' | t }}</span>
                {%- render 'icon', name: 'arrow-right', size: 18 -%}
              </button>
            </div>
          {%- endform -%}
        </div>
      </section>
    {%- endif -%}
  </main-article>
</section>

<script src="{{ 'section-main-article.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Article",
  "class": "shopify-section--main-article",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Featured image height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Parallax featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt under title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reading_time",
      "label": "Show reading time",
      "default": true
    },
    {
      "type": "header",
      "content": "Reading"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Reading progress bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "drop_cap",
      "label": "Drop cap on first paragraph",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share buttons",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors & spacing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "%",
      "label": "Top padding",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "%",
      "label": "Bottom padding",
      "default": 100
    }
  ]
}
{% endschema %}
